# Environment variables and PATH. Secrets do not belong here. They go in
# ~/.dotfiles/.env, which is never committed.

# Where the repos live. Override this, or any repo below, in .env.
: "${GITHUB_DIR:=$HOME/Documents/GitHub}"

# Google Cloud SDK
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# npm global
export PATH="$HOME/.npm-global/bin:$PATH"

# Java / Android
export PATH="/opt/homebrew/opt/gradle@7/bin:$PATH"
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$PATH:$ANDROID_HOME/emulator"
export PATH="$PATH:$ANDROID_HOME/platform-tools"

# Ruby (Homebrew)
if [ -d "/opt/homebrew/opt/ruby/bin" ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
  # Gems install under the Ruby API version: the formula version with the
  # patch number replaced by 0, so 3.4.7 gives 3.4.0. Reading it from the
  # symlink avoids starting Ruby on every shell, and a Ruby upgrade follows.
  _ruby_api="${${${:-/opt/homebrew/opt/ruby}:A:t}%.*}.0"
  export PATH="/opt/homebrew/lib/ruby/gems/$_ruby_api/bin:$PATH"
  unset _ruby_api
fi

# Other tools
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Build flags
export LDFLAGS="-L/opt/homebrew/opt/bzip2/lib"
export CPPFLAGS="-I/opt/homebrew/opt/bzip2/include"

# Re-apply mise after the PATH changes above so selected runtimes stay ahead
# of system binaries.
command -v mise >/dev/null && eval "$(mise activate --shims zsh)"

# This repo's scripts, then the user-level bin that installers write to.
export PATH="$DOTFILES/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# ------------------------------------------------------------------
# Secrets
# Fill these in on each machine. bin/install copies this file to .env,
# and .env is never committed.
# One KEY=value per line. The shell exports every key. Quote a value
# that contains spaces or a dollar sign.
# ------------------------------------------------------------------

# Private app token for the HubSpot tickets API.
HUBSPOT_TICKETS_TOKEN=

# ------------------------------------------------------------------
# Repositories
# Every repo is expected under GITHUB_DIR. Uncomment a line to change
# the default. A setting for one repo wins over GITHUB_DIR.
# ------------------------------------------------------------------

#GITHUB_DIR="$HOME/Documents/GitHub"

# ------------------------------------------------------------------
# ApartmentAdvisor
# ------------------------------------------------------------------

#ADVISOR_WORKSPACE="${GITHUB_DIR}/advisor-site"
#GCP_LOG_VIEWER_DIR="${GITHUB_DIR}/gcp-log-viewer"

# ------------------------------------------------------------------
# RetroAchievements
# ------------------------------------------------------------------

#RAWEB_DIR="${GITHUB_DIR}/RAWeb"

# The rclone path that holds the database backups.
#RA_BACKUP_REMOTE="r2:backup/db-backup"

# ------------------------------------------------------------------
# Wardstone
# ------------------------------------------------------------------

#WARDSTONE_DIR="${GITHUB_DIR}/GameDev/wardstone"

# The ssh target that wsplay uploads playtest notes to. Leave it empty
# to skip the upload, for example on server-mbp itself.
#WSPLAY_REMOTE="server-mbp@server-mbp"
